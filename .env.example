# =========================================================================
# PriceMaster — переменные окружения (скопируйте этот файл в .env)
# =========================================================================
# Копия:  cp .env.example .env
# Указывать реальные значения перед запуском локально или в Docker.

# --- База данных (PostgreSQL) ---
# URL для локальной разработки (без Docker)
DATABASE_URL=postgresql+psycopg://pricemaster:pricemaster@localhost:5432/pricemaster
# Учётка, используемая сервисом db внутри docker-compose
POSTGRES_USER=pricemaster
POSTGRES_PASSWORD=pricemaster
POSTGRES_DB=pricemaster

# --- Telegram-бот ---
# Токен от @BotFather — обязателен для работы бота
BOT_TOKEN=ЗАМЕНИТЕ_НА_ТОКЕН
# Секретный ключ доступа; выдаётся преподавателю/тестировщику (см. ТЗ, раздел 5)
ACCESS_KEY=supersecret

# --- Бэкенд API ---
# Адрес, по которому бот и дашборд ходят к FastAPI
API_URL=http://localhost:8000
# Таймаут HTTP-запросов к API (секунды)
API_TIMEOUT=10

# --- LLM (OpenAI-совместимый API) ---
# Локально: Ollama поднимается сервисом llm в docker-compose (порт 11434)
# Альтернатива — любой OpenAI-совместимый хост (Qwen, Groq, YandexGPT и т.п.)
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Название модели. Точного тега "Qwen 9B"/"qwen2.5:9b" в Ollama нет —
# подберите ближайший по размеру, напр. qwen2.5:14b или qwen2.5:7b
LLM_MODEL=qwen2.5:14b

# --- Локальный запуск (make) ---
# Хост/порт API
API_HOST=127.0.0.1
API_PORT=8000