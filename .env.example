# =========================================================================
# PriceMaster — переменные окружения (скопируйте этот файл в .env)
# =========================================================================
# Копия:  cp .env.example .env
# Заполните реальные значения перед запуском локально или в Docker.
# Полный список переменных: docs/SDD.md, Приложение A, раздел 14.

# --- База данных (PostgreSQL) ---
# URL подключения к PostgreSQL (asyncpg — драйвер для SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://pricemaster:pricemaster@localhost:5432/pricemaster
# Учётка, используемая сервисом db внутри docker-compose
POSTGRES_USER=pricemaster
POSTGRES_PASSWORD=pricemaster
POSTGRES_DB=pricemaster

# --- Аутентификация ---
# Секретный ключ подписи JWT-токенов (POST /auth/login)
# .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ
# Секретный ключ доступа
ACCESS_KEY=supersecret

# --- LLM (внешний OpenAI-совместимый API, Qwen) ---
LLM_API_URL=https://ЗАМЕНИТЕ_НА_ХОСТ/v1
LLM_API_KEY=ЗАМЕНИТЕ_НА_КЛЮЧ
# Название модели
LLM_MODEL=qwen-plus

# --- Локальный запуск (make api) ---
API_HOST=127.0.0.1
API_PORT=8000