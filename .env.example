# =========================================================================
# PriceMaster - environment variables (copy to .env)
# =========================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://pricemaster:pricemaster@localhost:5432/pricemaster
POSTGRES_USER=pricemaster
POSTGRES_PASSWORD=pricemaster
POSTGRES_DB=pricemaster

# --- Auth ---
# Generate a random secret (>=16 chars):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
ACCESS_KEY=

# --- LLM (OpenAI-compatible API) ---
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- API server (make api) ---
API_HOST=127.0.0.1
API_PORT=8000